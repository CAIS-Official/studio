---
import Base from '../../layouts/Base.astro';
const t = await import('../../i18n/es.json');
---

<Base locale="en" title="Web Solutions">
  <!-- HERO -->
  <section class="hero-wrapper py-5 d-flex align-items-center" style="min-height: 82vh;">
    <div class="hero-glow"></div>
    <div class="container hero-content text-center">
      <h1 class="display-3 fw-bold mb-4 text-gradient">{t.hero.title}</h1>
      <p class="lead fw-medium mb-5 mx-auto hero-lead">{t.hero.subtitle}</p>
      <a href="#services" class="btn btn-primary btn-lg px-5 py-3 rounded-pill mb-5">{t.hero.cta} <i class="bi bi-arrow-down ms-1"></i></a>
      <div class="mt-4">
        <p class="text-secondary small text-uppercase fw-bold mb-3 tech-label">{t.hero.tech_text}</p>
        <div class="d-flex justify-content-center gap-4 fs-2 text-primary">
          <i class="bi bi-code-slash" title="Astro"></i><i class="bi bi-bootstrap" title="Bootstrap"></i><i class="bi bi-github" title="GitHub"></i><i class="bi bi-robot" title="AI"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section id="why" class="py-5 section-divider">
    <div class="container py-lg-4">
      <div class="text-center section-heading mb-5"><span class="section-kicker">THE CAIS APPROACH</span><h2 class="text-white">{t.why.title}</h2></div>
      <div class="row g-4">
        <div class="col-md-4"><article class="value-card h-100"><i class="bi bi-speedometer2"></i><h4>{t.why.item1_title}</h4><p>{t.why.item1_desc}</p></article></div>
        <div class="col-md-4"><article class="value-card h-100"><i class="bi bi-translate"></i><h4>{t.why.item2_title}</h4><p>{t.why.item2_desc}</p></article></div>
        <div class="col-md-4"><article class="value-card h-100"><i class="bi bi-shield-check"></i><h4>{t.why.item3_title}</h4><p>{t.why.item3_desc}</p></article></div>
      </div>
    </div>
  </section>

<!-- PORTFOLIO ACTUALIZADO -->
  <section id="portfolio" class="py-5 section-divider">
    <div class="container py-4">
      <div class="row align-items-center g-5">
        
        <!-- LADO IZQUIERDO: Simulador de Código (ES) -->
        <div class="col-lg-6">
          <div class="portfolio-code-card">
            <div class="code-header">
              <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
              <span class="ms-3 text-secondary small font-monospace">xam-goth-apparel.ts</span>
            </div>
            
            <div class="code-body font-monospace small" style="padding: 2rem 1.5rem;">
              <div><span class="text-primary">const</span> marca = <span class="text-info">'XAM Goth Apparel'</span>;</div>
              <div><span class="text-primary">const</span> stack = [<span class="text-info">'Astro'</span>, <span class="text-info">'Tailwind'</span>, <span class="text-info">'TypeScript'</span>];</div>
              <br>
              <div class="text-secondary">// Construyendo presencia web desde cero...</div>
              <div><span class="text-primary">async function</span> <span class="text-warning">crearWebIncreible</span>() &#123;</div>
              <div class="ps-4"><span class="text-primary">const</span> diseño = <span class="text-primary">await</span> <span class="text-info">generarUI</span>(<span class="text-info">'tema-oscuro'</span>);</div>
              <div class="ps-4"><span class="text-primary">return</span> &#123; estado: <span class="text-info">'Éxito'</span>, codigo: <span class="text-info">'Limpio'</span> &#125;;</div>
              <div>&#125;</div>
              <br>
              <div class="text-secondary">// Listo para producción! 🚀</div>
            </div>
          </div>
        </div>

        <!-- LADO DERECHO: Textos (se mantiene igual) -->
        <div class="col-lg-6">
          <span class="section-kicker">SELECTED WORK</span>
          <h2 class="text-white mb-4">{t.portfolio.title}</h2>
          <p class="text-secondary fs-5 mb-4"><Fragment set:html={t.portfolio.desc1} /></p>
          <p class="text-secondary mb-5">{t.portfolio.desc2}</p>
          <a href="https://github.com/orgs/CAIS-Official/repositories" target="_blank" rel="noopener" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill"><i class="bi bi-github me-2"></i>{t.portfolio.btn_github}</a>
        </div>

      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section id="process" class="py-5 section-divider">
    <div class="container py-4">
      <div class="text-center mb-5">
        <span class="section-kicker">FROM IDEA TO LAUNCH</span>
        <h2 class="text-white">{t.process.title}</h2>
        <p class="text-secondary">{t.process.subtitle}</p>
      </div>
      <div class="row g-4">
        <div class="col-md-3 process-step">
          <div class="process-icon">1</div>
          <h5 class="text-white mt-3">{t.process.step1_title}</h5>
          <p class="text-secondary small">{t.process.step1_desc}</p>
        </div>
        <div class="col-md-3 process-step">
          <div class="process-icon">2</div>
          <h5 class="text-white mt-3">{t.process.step2_title}</h5>
          <p class="text-secondary small">{t.process.step2_desc}</p>
        </div>
        <div class="col-md-3 process-step">
          <div class="process-icon">3</div>
          <h5 class="text-white mt-3">{t.process.step3_title}</h5>
          <p class="text-secondary small">{t.process.step3_desc}</p>
        </div>
        <div class="col-md-3 process-step">
          <div class="process-icon">4</div>
          <h5 class="text-white mt-3">{t.process.step4_title}</h5>
          <p class="text-secondary small">{t.process.step4_desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="py-5 section-divider pricing-section">
    <div class="container py-4">
      <div class="text-center mb-5"><span class="section-kicker">{t.services.eyebrow}</span><h2 class="text-white display-5 fw-bold">{t.services.title}</h2><p class="text-secondary mx-auto section-intro">{t.services.subtitle}</p></div>
      <div class="row g-4 align-items-stretch">
        <div class="col-lg-4"><article class="pricing-card h-100"><div class="pricing-icon"><i class="bi bi-window"></i></div><h3>{t.services.landing_title}</h3><p class="pricing-description">{t.services.landing_desc}</p><div class="price-label">{t.services.from}</div><div class="price-value">{t.services.landing_price}</div><p class="scope-note">{t.services.landing_scope}</p><ul class="plan-list"><li>{t.services.feature1}</li><li>{t.services.feature2}</li><li>{t.services.feature3}</li><li>{t.services.feature4}</li></ul><a class="btn btn-outline-light w-100 mt-auto" href="https://wa.me/61411918190?text=Hi%2C%20I%27m%20interested%20in%20a%20Landing%20Page." target="_blank" rel="noopener">{t.services.btn_hire} <i class="bi bi-arrow-up-right ms-1"></i></a></article></div>
        <div class="col-lg-4"><article class="pricing-card pricing-card-featured h-100"><div class="popular-label">{t.services.popular}</div><div class="pricing-icon"><i class="bi bi-building"></i></div><h3>{t.services.business_title}</h3><p class="pricing-description">{t.services.business_desc}</p><div class="price-label">{t.services.from}</div><div class="price-value">{t.services.business_price}</div><p class="scope-note">{t.services.business_scope}</p><ul class="plan-list"><li>{t.services.feature1}</li><li>{t.services.feature2}</li><li>{t.services.feature3}</li><li>{t.services.feature4}</li><li>{t.services.feature5}</li></ul><a class="btn btn-primary w-100 mt-auto" href="https://wa.me/61411918190?text=Hi%2C%20I%27m%20interested%20in%20a%20Business%20Website." target="_blank" rel="noopener">{t.services.btn_hire} <i class="bi bi-arrow-up-right ms-1"></i></a></article></div>
        <div class="col-lg-4"><article class="pricing-card h-100"><div class="pricing-icon"><i class="bi bi-cart3"></i></div><h3>{t.services.ecommerce_title}</h3><p class="pricing-description">{t.services.ecommerce_desc}</p><div class="price-label">{t.services.custom}</div><div class="price-value price-custom">{t.services.ecommerce_price}</div><p class="scope-note">{t.services.ecommerce_scope}</p><ul class="plan-list"><li>{t.services.feature1}</li><li>{t.services.feature3}</li><li>{t.services.feature6}</li><li>{t.services.feature4}</li></ul><a class="btn btn-outline-light w-100 mt-auto" href="https://wa.me/61411918190?text=Hi%2C%20I%27d%20like%20to%20talk%20about%20an%20E-commerce%20project." target="_blank" rel="noopener">{t.services.btn_hire} <i class="bi bi-arrow-up-right ms-1"></i></a></article></div>
      </div>
      <p class="pricing-disclaimer text-center mt-4"><i class="bi bi-info-circle me-2"></i>{t.services.quote_note}</p>
    </div>
  </section>

<!-- COMPARISON -->
<section id="comparison" class="py-5 section-divider">
  <div class="container py-4">
    <div class="text-center mb-5">
      <span class="section-kicker">AT A GLANCE</span>
      <h2 class="text-white">{t.services.compare_title}</h2>
      <p class="text-secondary">{t.services.compare_subtitle}</p>
    </div>

    <div class="comparison-wrap">
      <div class="table-responsive">
        <table class="table comparison-table align-middle mb-0">
          <thead>
            <tr>
              <th>{t.services.features_title}</th>
              <th>Landing Page</th>
              <th>{t.services.business_title}</th>
              <th>E-commerce</th>
            </tr>
          </thead>
          <tbody>
            <tr><th>{t.services.row_pages}</th><td>1 page</td><td>Up to 5 pages*</td><td>Custom</td></tr>
            <tr><th>{t.services.row_design}</th><td><i class="bi bi-check-lg"></i></td><td><i class="bi bi-check-lg"></i></td><td><i class="bi bi-check-lg"></i></td></tr>
            <tr><th>{t.services.row_seo}</th><td><i class="bi bi-check-lg"></i></td><td><i class="bi bi-check-lg"></i></td><td><i class="bi bi-check-lg"></i></td></tr>
            <tr><th>{t.services.row_forms}</th><td>{t.services.optional}</td><td>{t.services.included}</td><td>{t.services.optional}</td></tr>
            <tr><th>{t.services.row_cms}</th><td>{t.services.not_included}</td><td>{t.services.optional}</td><td>{t.services.optional}</td></tr>
            <tr><th>{t.services.row_shop}</th><td>{t.services.not_included}</td><td>{t.services.not_included}</td><td>{t.services.custom_scope}</td></tr>
            <tr><th>{t.services.row_payment}</th><td>{t.services.not_included}</td><td>{t.services.not_included}</td><td>{t.services.custom_scope}</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="small text-secondary mt-3">* {t.services.quote_note}</p>
  </div>
</section>

  <!-- MAINTENANCE -->
  <section id="maintenance" class="py-5 section-divider"><div class="container py-4">
    <div class="text-center mb-5"><span class="section-kicker">AFTER LAUNCH</span><h2 class="text-white">{t.services.maintenance_title}</h2><p class="text-secondary mx-auto section-intro">{t.services.maintenance_subtitle}</p></div>
    <div class="row g-4 mb-4">
      <div class="col-lg-6"><article class="info-panel h-100"><div class="info-icon"><i class="bi bi-life-preserver"></i></div><h3>{t.services.support_title}</h3><p>{t.services.support_desc}</p></article></div>
      <div class="col-lg-6"><article class="info-panel h-100"><div class="info-icon"><i class="bi bi-tools"></i></div><h3>{t.services.maintenance_included_title}</h3><p>{t.services.maintenance_included_desc}</p></article></div>
    </div>
    <div class="maintenance-heading text-center mt-5 mb-4"><h3 class="text-white">{t.services.maintenance_plan_title}</h3><p class="text-secondary">{t.services.maintenance_plan_desc}</p></div>
    <div class="row g-3">
      <div class="col-md-4"><div class="maintenance-card h-100"><h4>{t.services.maintenance_landing}</h4><div class="maintenance-price">{t.services.maintenance_landing_price}</div><p>{t.services.maintenance_landing_time}</p></div></div>
      <div class="col-md-4"><div class="maintenance-card h-100"><h4>{t.services.maintenance_business}</h4><div class="maintenance-price">{t.services.maintenance_business_price}</div><p>{t.services.maintenance_business_time}</p></div></div>
      <div class="col-md-4"><div class="maintenance-card h-100"><h4>{t.services.maintenance_ecommerce}</h4><div class="maintenance-price">{t.services.maintenance_ecommerce_price}</div><p>{t.services.maintenance_ecommerce_time}</p></div></div>
    </div>
    <div class="maintenance-detail mt-4"><h4>{t.services.maintenance_includes_title}</h4><p>{t.services.maintenance_includes}</p><p class="mb-0"><strong>{t.services.not_included}:</strong> {t.services.maintenance_excludes}</p></div>
  </div></section>

  <!-- CONDITIONS -->
  <section id="conditions" class="py-5 section-divider"><div class="container py-4">
    <div class="text-center mb-5"><span class="section-kicker">CLEAR FROM DAY ONE</span><h2 class="text-white">{t.services.conditions_title}</h2><p class="text-secondary">{t.services.conditions_subtitle}</p></div>
    <div class="row g-3">
      <div class="col-md-6"><article class="condition-card"><i class="bi bi-credit-card"></i><div><h4>{t.services.payment_title}</h4><p>{t.services.payment_desc}</p></div></article></div>
      <div class="col-md-6"><article class="condition-card"><i class="bi bi-arrow-repeat"></i><div><h4>{t.services.revisions_title}</h4><p>{t.services.revisions_desc}</p></div></article></div>
      <div class="col-md-6"><article class="condition-card"><i class="bi bi-images"></i><div><h4>{t.services.content_title}</h4><p>{t.services.content_desc}</p></div></article></div>
      <div class="col-md-6"><article class="condition-card"><i class="bi bi-cloud-arrow-up"></i><div><h4>{t.services.hosting_title}</h4><p>{t.services.hosting_desc}</p></div></article></div>
      <div class="col-12"><article class="condition-card"><i class="bi bi-file-earmark-check"></i><div><h4>{t.services.scope_title}</h4><p>{t.services.scope_desc}</p></div></article></div>
    </div>
    <div class="documents-panel mt-5 text-center"><div class="info-icon mx-auto"><i class="bi bi-file-earmark-pdf"></i></div><h3>{t.services.docs_title}</h3><p class="text-secondary">{t.services.docs_desc}</p><div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4"><a class="btn btn-outline-light" href={`${import.meta.env.BASE_URL}documents/CAIS-Services-and-Conditions.pdf`} target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i>{t.services.doc_en}</a><a class="btn btn-outline-light" href={`${import.meta.env.BASE_URL}documents/CAIS-Servicios-y-Condiciones.pdf`} target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf me-2"></i>{t.services.doc_es}</a></div></div>
  </div></section>

  <!-- FAQ (CORREGIDO CON TUS VARIABLES) -->
  <section id="faq" class="py-5 section-divider">
    <div class="container py-4">
      <div class="text-center mb-5">
        <span class="section-kicker">GOOD TO KNOW</span>
        <h2 class="text-white">{t.services.faq_title}</h2>
      </div>
      <div class="faq-list mx-auto">
        <details class="faq-item">
          <summary>{t.services.faq1_q}</summary>
          <p>{t.services.faq1_a}</p>
        </details>
        <details class="faq-item">
          <summary>{t.services.faq2_q}</summary>
          <p>{t.services.faq2_a}</p>
        </details>
        <details class="faq-item">
          <summary>{t.services.faq3_q}</summary>
          <p>{t.services.faq3_a}</p>
        </details>
        <details class="faq-item">
          <summary>{t.services.faq4_q}</summary>
          <p>{t.services.faq4_a}</p>
        </details>
        <details class="faq-item">
          <summary>{t.services.faq5_q}</summary>
          <p>{t.services.faq5_a}</p>
        </details>
      </div>
    </div>
  </section>

<!-- CONTACT -->
<section id="contact" class="contact-section py-5 section-divider">
  <div class="container py-5">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <span class="section-kicker">LET'S BUILD SOMETHING</span>
        <h2 class="display-4 fw-bold text-white mb-4">{t.contact.title}</h2>
        <p class="lead text-secondary mb-5">{t.contact.subtitle}</p>
        
        <!-- BOTONES REDISEÑADOS -->
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
          <a href="mailto:cais.theteam@gmail.com" class="btn btn-outline-light px-4 py-2 fs-5 rounded-3">
            <i class="bi bi-envelope me-2"></i>{t.contact.btn_email}
          </a>
          <a href="https://wa.me/61411918190?text=Hi%2C%20I%27d%20like%20to%20talk%20about%20a%20web%20project." target="_blank" rel="noopener" class="btn btn-primary px-4 py-2 fs-5 rounded-3 fw-bold">
            <i class="bi bi-whatsapp me-2"></i>{t.contact.btn_whatsapp}
          </a>
        </div>
        
      </div>
    </div>
  </div>
</section>

</Base>